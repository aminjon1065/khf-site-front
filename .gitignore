# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/lighthouse-results/
/.lighthouseci/
/bundle-reports/

# next.js
/.next/
# Изолированные dist-каталоги стенда Playwright (playwright.config.ts,
# NEXT_DIST_DIR). Содержимое то же, что в /.next/, — отдельные сборки нужны
# только чтобы серверы стенда не конфликтовали за dev-lock с обычным
# `npm run dev` и друг с другом.
/.next-e2e/
/.next-backend-down-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...но шаблон коммитим (документирует Laragon/Herd для других машин)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
