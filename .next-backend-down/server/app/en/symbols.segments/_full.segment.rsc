16:["$","div",null,{"className":"border-b border-[var(--color-divider)] pb-3.5","children":[["$","h1",null,{"className":"mb-2.5 mt-0 text-[36px] uppercase tracking-[.02em]","children":"State symbols of the Republic of Tajikistan"}],["$","p",null,{"className":"m-0 max-w-[70ch] text-[14.5px] leading-[1.6]","style":{"color":"color-mix(in srgb,var(--color-text) 70%,transparent)"},"children":"The State Flag, the State Emblem and the State Anthem are symbols of the sovereignty of the Republic of Tajikistan. The rules for their use are established by resolutions No. 499 and No. 500 of the Assembly of Representatives of the Supreme Assembly of the Republic of Tajikistan of 14 March 2007 and by the Law of the RT “On the State Anthem”."}]]}]
17:["$","section","Symbol 01",{"aria-label":"State Flag","className":"grid grid-cols-[minmax(0,420px)_minmax(0,1fr)] items-start gap-8 max-[920px]:grid-cols-1 mt-8","children":[["$","figure",null,{"className":"blueprint m-0 grid place-items-center p-6","children":["$","$L1d",null,{"src":"/assets/flag-tj.png","alt":"State Flag of the Republic of Tajikistan: three horizontal stripes — red, white with a golden crown and seven stars, green","width":1920,"height":960,"className":"h-auto w-full","style":{"maxWidth":340,"height":"auto","border":"1px solid var(--color-divider)"}}]}],["$","div",null,{"className":"min-w-0","children":[["$","span",null,{"className":"text-[11px] uppercase tracking-[.1em]","style":{"color":"var(--color-accent-700)"},"children":"Symbol 01"}],["$","h2",null,{"className":"mb-2.5 mt-1.5 text-[26px] uppercase tracking-[.02em]","children":"State Flag"}],[["$","p","A cloth of three horizontal stripes: red, white and green. The white stripe is one and a half times wider than the red and green ones. In the centre of the white stripe is a stylised golden crown with a semicircle of seven stars. The ratio of the flag's width to its length is 1:2.",{"className":"max-w-[64ch]","style":{"fontSize":14.5,"lineHeight":1.65},"children":"A cloth of three horizontal stripes: red, white and green. The white stripe is one and a half times wider than the red and green ones. In the centre of the white stripe is a stylised golden crown with a semicircle of seven stars. The ratio of the flag's width to its length is 1:2."}],["$","p","Red symbolises the unity of the nation, white — purity and the snows of the mountains, green — nature and the fertility of the valleys. The crown and seven stars express state sovereignty and the friendship of peoples.",{"className":"max-w-[64ch]","style":{"fontSize":13.5,"lineHeight":1.6,"color":"color-mix(in srgb,var(--color-text) 68%,transparent)"},"children":"Red symbolises the unity of the nation, white — purity and the snows of the mountains, green — nature and the fertility of the valleys. The crown and seven stars express state sovereignty and the friendship of peoples."}]],["$","p",null,{"className":"mt-3","style":{"fontSize":12,"color":"color-mix(in srgb,var(--color-text) 65%,transparent)"},"children":"Approved by resolution No. 499 of the AR SA RT of 14.03.2007. State Flag Day is 24 November."}]]}]]}]
18:["$","section","Symbol 02",{"aria-label":"State Emblem","className":"grid grid-cols-[minmax(0,420px)_minmax(0,1fr)] items-start gap-8 max-[920px]:grid-cols-1 mt-10","children":[["$","figure",null,{"className":"blueprint m-0 grid place-items-center p-6","children":["$","$L1d",null,{"src":"/assets/emblem-tj.png","alt":"State Emblem of the Republic of Tajikistan: a crown with seven stars in the rays of the sun above the mountains, framed by ears of wheat and cotton branches","width":330,"height":327,"className":"h-auto w-full","style":{"maxWidth":240,"height":"auto"}}]}],["$","div",null,{"className":"min-w-0","children":[["$","span",null,{"className":"text-[11px] uppercase tracking-[.1em]","style":{"color":"var(--color-accent-700)"},"children":"Symbol 02"}],["$","h2",null,{"className":"mb-2.5 mt-1.5 text-[26px] uppercase tracking-[.02em]","children":"State Emblem"}],[["$","p","A depiction of a stylised crown and a semicircle of seven stars in the rays of the sun rising from behind snow-covered mountains. The emblem is framed by a wreath: ears of wheat on the right, cotton branches with open bolls on the left. The wreath is entwined with a ribbon in the colours of the State Flag; at the bottom is an open book on a stand.",{"className":"max-w-[64ch]","style":{"fontSize":14.5,"lineHeight":1.65},"children":"A depiction of a stylised crown and a semicircle of seven stars in the rays of the sun rising from behind snow-covered mountains. The emblem is framed by a wreath: ears of wheat on the right, cotton branches with open bolls on the left. The wreath is entwined with a ribbon in the colours of the State Flag; at the bottom is an open book on a stand."}]],["$","p",null,{"className":"mt-3","style":{"fontSize":12,"color":"color-mix(in srgb,var(--color-text) 65%,transparent)"},"children":"Approved by resolution No. 500 of the AR SA RT of 14.03.2007. Displaying the Emblem on the official website is a mandatory attribute of a state authority."}]]}]]}]
