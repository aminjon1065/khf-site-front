{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/map/layout,_N_T_/[locale]/map/page,_N_T_/en/map,cms"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/map/__PAGE__",
    "/$d$locale/map",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}