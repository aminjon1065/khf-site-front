{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/contacts/layout,_N_T_/[locale]/contacts/page,_N_T_/tj/contacts,cms"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/contacts/__PAGE__",
    "/$d$locale/contacts",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}