16:["$","div",null,{"className":"border-b border-[var(--color-divider)] pb-3.5","children":[["$","h1",null,{"className":"mb-2.5 mt-0 text-[36px] uppercase tracking-[.02em]","children":"Рамзҳои давлатии Ҷумҳурии Тоҷикистон"}],["$","p",null,{"className":"m-0 max-w-[70ch] text-[14.5px] leading-[1.6]","style":{"color":"color-mix(in srgb,var(--color-text) 70%,transparent)"},"children":"Парчами давлатӣ, Нишони давлатӣ ва Суруди миллӣ — рамзҳои соҳибихтиёрии Ҷумҳурии Тоҷикистон мебошанд. Тартиби истифодаи онҳо бо қарорҳои Маҷлиси намояндагони Маҷлиси Олии Ҷумҳурии Тоҷикистон аз 14 марти соли 2007 № 499 ва № 500 ва Қонуни ҶТ «Дар бораи Суруди миллӣ» муқаррар шудааст."}]]}]
17:["$","section","Рамз 01",{"aria-label":"Парчами давлатӣ","className":"grid grid-cols-[minmax(0,420px)_minmax(0,1fr)] items-start gap-8 max-[920px]:grid-cols-1 mt-8","children":[["$","figure",null,{"className":"blueprint m-0 grid place-items-center p-6","children":["$","$L1c",null,{"src":"/assets/flag-tj.png","alt":"Парчами давлатии Ҷумҳурии Тоҷикистон: се тасмаи уфуқӣ — сурх, сафед бо тоҷи тиллоӣ ва ҳафт ситора, сабз","width":1920,"height":960,"className":"h-auto w-full","style":{"maxWidth":340,"height":"auto","border":"1px solid var(--color-divider)"}}]}],["$","div",null,{"className":"min-w-0","children":[["$","span",null,{"className":"text-[11px] uppercase tracking-[.1em]","style":{"color":"var(--color-accent-700)"},"children":"Рамз 01"}],["$","h2",null,{"className":"mb-2.5 mt-1.5 text-[26px] uppercase tracking-[.02em]","children":"Парчами давлатӣ"}],[["$","p","Матоъ аз се тасмаи уфуқӣ: сурх, сафед ва сабз. Бари тасмаи сафед аз сурху сабз якуним баробар зиёд аст. Дар маркази тасмаи сафед — тоҷи стилизатсияшудаи тиллоӣ бо нимдоираи ҳафт ситора. Таносуби бар ба дарозии парчам — 1:2.",{"className":"max-w-[64ch]","style":{"fontSize":14.5,"lineHeight":1.65},"children":"Матоъ аз се тасмаи уфуқӣ: сурх, сафед ва сабз. Бари тасмаи сафед аз сурху сабз якуним баробар зиёд аст. Дар маркази тасмаи сафед — тоҷи стилизатсияшудаи тиллоӣ бо нимдоираи ҳафт ситора. Таносуби бар ба дарозии парчам — 1:2."}],["$","p","Ранги сурх рамзи ягонагии миллат, сафед — покӣ ва барфи кӯҳҳо, сабз — табиат ва ҳосилхезии водиҳо. Тоҷ ва ҳафт ситора соҳибихтиёрии давлатӣ ва дӯстии халқҳоро ифода мекунанд.",{"className":"max-w-[64ch]","style":{"fontSize":13.5,"lineHeight":1.6,"color":"color-mix(in srgb,var(--color-text) 68%,transparent)"},"children":"Ранги сурх рамзи ягонагии миллат, сафед — покӣ ва барфи кӯҳҳо, сабз — табиат ва ҳосилхезии водиҳо. Тоҷ ва ҳафт ситора соҳибихтиёрии давлатӣ ва дӯстии халқҳоро ифода мекунанд."}]],["$","p",null,{"className":"mt-3","style":{"fontSize":12,"color":"color-mix(in srgb,var(--color-text) 65%,transparent)"},"children":"Бо қарори МН МО ҶТ аз 14.03.2007, № 499 тасдиқ шудааст. Рӯзи Парчами давлатӣ — 24 ноябр."}]]}]]}]
18:["$","section","Рамз 02",{"aria-label":"Нишони давлатӣ","className":"grid grid-cols-[minmax(0,420px)_minmax(0,1fr)] items-start gap-8 max-[920px]:grid-cols-1 mt-10","children":[["$","figure",null,{"className":"blueprint m-0 grid place-items-center p-6","children":["$","$L1c",null,{"src":"/assets/emblem-tj.png","alt":"Нишони давлатии Ҷумҳурии Тоҷикистон: тоҷ бо ҳафт ситора дар нурҳои офтоб болои кӯҳҳо, иҳоташуда бо хӯшаҳои гандум ва навдаҳои пахта","width":330,"height":327,"className":"h-auto w-full","style":{"maxWidth":240,"height":"auto"}}]}],["$","div",null,{"className":"min-w-0","children":[["$","span",null,{"className":"text-[11px] uppercase tracking-[.1em]","style":{"color":"var(--color-accent-700)"},"children":"Рамз 02"}],["$","h2",null,{"className":"mb-2.5 mt-1.5 text-[26px] uppercase tracking-[.02em]","children":"Нишони давлатӣ"}],[["$","p","Тасвири тоҷи стилизатсияшуда ва нимдоираи ҳафт ситора дар нурҳои офтобе, ки аз паси кӯҳҳои барфпӯш тулӯъ мекунад. Нишон бо гулчанбар иҳота шудааст: аз рост — аз хӯшаҳои гандум, аз чап — аз навдаҳои пахта бо ғӯзапахтаҳои кушода. Гулчанбар бо тасмаи рангҳои Парчами давлатӣ печонида шудааст; дар қисми поён — китоби кушода дар рӯи пойгаҳ.",{"className":"max-w-[64ch]","style":{"fontSize":14.5,"lineHeight":1.65},"children":"Тасвири тоҷи стилизатсияшуда ва нимдоираи ҳафт ситора дар нурҳои офтобе, ки аз паси кӯҳҳои барфпӯш тулӯъ мекунад. Нишон бо гулчанбар иҳота шудааст: аз рост — аз хӯшаҳои гандум, аз чап — аз навдаҳои пахта бо ғӯзапахтаҳои кушода. Гулчанбар бо тасмаи рангҳои Парчами давлатӣ печонида шудааст; дар қисми поён — китоби кушода дар рӯи пойгаҳ."}]],["$","p",null,{"className":"mt-3","style":{"fontSize":12,"color":"color-mix(in srgb,var(--color-text) 65%,transparent)"},"children":"Бо қарори МН МО ҶТ аз 14.03.2007, № 500 тасдиқ шудааст. Тасвири Нишон дар сомонаи расмӣ атрибути ҳатмии мақоми давлатӣ мебошад."}]]}]]}]
