4:["$","div",null,{"className":"border-b border-[var(--color-divider)] pb-3.5","children":[["$","h1",null,{"className":"mb-2.5 mt-0 text-[36px] uppercase tracking-[.02em]","children":"Государственные символы Республики Таджикистан"}],["$","p",null,{"className":"m-0 max-w-[70ch] text-[14.5px] leading-[1.6]","style":{"color":"color-mix(in srgb,var(--color-text) 70%,transparent)"},"children":"Государственный Флаг, Государственный Герб и Государственный Гимн — символы суверенитета Республики Таджикистан. Порядок их использования установлен постановлениями Маджлиси намояндагон Маджлиси Оли Республики Таджикистан от 14 марта 2007 года № 499 и № 500 и Законом РТ «О Государственном Гимне»."}]]}]
5:["$","section","Символ 01",{"aria-label":"Государственный Флаг","className":"grid grid-cols-[minmax(0,420px)_minmax(0,1fr)] items-start gap-8 max-[920px]:grid-cols-1 mt-8","children":[["$","figure",null,{"className":"blueprint m-0 grid place-items-center p-6","children":["$","$Le",null,{"src":"/assets/flag-tj.png","alt":"Государственный Флаг Республики Таджикистан: три горизонтальные полосы — красная, белая с золотой короной и семью звёздами, зелёная","width":1920,"height":960,"className":"h-auto w-full","style":{"maxWidth":340,"height":"auto","border":"1px solid var(--color-divider)"}}]}],["$","div",null,{"className":"min-w-0","children":[["$","span",null,{"className":"text-[11px] uppercase tracking-[.1em]","style":{"color":"var(--color-accent-700)"},"children":"Символ 01"}],["$","h2",null,{"className":"mb-2.5 mt-1.5 text-[26px] uppercase tracking-[.02em]","children":"Государственный Флаг"}],[["$","p","Полотнище из трёх горизонтальных полос: красной, белой и зелёной. Ширина белой полосы в полтора раза больше красной и зелёной. В центре белой полосы — стилизованная золотая корона с полукругом из семи звёзд. Отношение ширины флага к длине — 1:2.",{"className":"max-w-[64ch]","style":{"fontSize":14.5,"lineHeight":1.65},"children":"Полотнище из трёх горизонтальных полос: красной, белой и зелёной. Ширина белой полосы в полтора раза больше красной и зелёной. В центре белой полосы — стилизованная золотая корона с полукругом из семи звёзд. Отношение ширины флага к длине — 1:2."}],["$","p","Красный цвет символизирует единство нации, белый — чистоту и снега гор, зелёный — природу и плодородие долин. Корона и семь звёзд выражают государственный суверенитет и дружбу народов.",{"className":"max-w-[64ch]","style":{"fontSize":13.5,"lineHeight":1.6,"color":"color-mix(in srgb,var(--color-text) 68%,transparent)"},"children":"Красный цвет символизирует единство нации, белый — чистоту и снега гор, зелёный — природу и плодородие долин. Корона и семь звёзд выражают государственный суверенитет и дружбу народов."}]],["$","p",null,{"className":"mt-3","style":{"fontSize":12,"color":"color-mix(in srgb,var(--color-text) 65%,transparent)"},"children":"Утверждён постановлением МН МО РТ от 14.03.2007, № 499. День Государственного флага — 24 ноября."}]]}]]}]
6:["$","section","Символ 02",{"aria-label":"Государственный Герб","className":"grid grid-cols-[minmax(0,420px)_minmax(0,1fr)] items-start gap-8 max-[920px]:grid-cols-1 mt-10","children":[["$","figure",null,{"className":"blueprint m-0 grid place-items-center p-6","children":["$","$Le",null,{"src":"/assets/emblem-tj.png","alt":"Государственный Герб Республики Таджикистан: корона с семью звёздами в лучах солнца над горами, обрамлённая колосьями пшеницы и ветками хлопчатника","width":330,"height":327,"className":"h-auto w-full","style":{"maxWidth":240,"height":"auto"}}]}],["$","div",null,{"className":"min-w-0","children":[["$","span",null,{"className":"text-[11px] uppercase tracking-[.1em]","style":{"color":"var(--color-accent-700)"},"children":"Символ 02"}],["$","h2",null,{"className":"mb-2.5 mt-1.5 text-[26px] uppercase tracking-[.02em]","children":"Государственный Герб"}],[["$","p","Изображение стилизованной короны и полукруга из семи звёзд в лучах солнца, восходящего из-за гор, покрытых снегом. Герб обрамлён венком: справа — из колосьев пшеницы, слева — из веток хлопчатника с раскрытыми коробочками. Венок перевит лентой цветов Государственного Флага; в нижней части — раскрытая книга на подставке.",{"className":"max-w-[64ch]","style":{"fontSize":14.5,"lineHeight":1.65},"children":"Изображение стилизованной короны и полукруга из семи звёзд в лучах солнца, восходящего из-за гор, покрытых снегом. Герб обрамлён венком: справа — из колосьев пшеницы, слева — из веток хлопчатника с раскрытыми коробочками. Венок перевит лентой цветов Государственного Флага; в нижней части — раскрытая книга на подставке."}]],["$","p",null,{"className":"mt-3","style":{"fontSize":12,"color":"color-mix(in srgb,var(--color-text) 65%,transparent)"},"children":"Утверждён постановлением МН МО РТ от 14.03.2007, № 500. Изображение Герба на официальном сайте является обязательным атрибутом государственного органа."}]]}]]}]
7:["$","section",null,{"aria-label":"Государственный Гимн","className":"mt-10","children":["$","div",null,{"className":"grid grid-cols-[minmax(0,420px)_minmax(0,1fr)] items-start gap-8 max-[920px]:grid-cols-1","children":[["$","div",null,{"className":"blueprint flex flex-col gap-3 p-6","style":{"background":"var(--color-accent-900)"},"children":[["$","svg",null,{"width":"28","height":"28","viewBox":"0 0 24 24","fill":"none","stroke":"#d6ebff","strokeWidth":1.5,"strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":[["$","path",null,{"d":"M9 18V5l12-2v13"}],["$","circle",null,{"cx":"6","cy":"18","r":"3"}],["$","circle",null,{"cx":"18","cy":"16","r":"3"}]]}],["$","span",null,{"className":"text-xl font-semibold text-white [font-family:var(--font-heading)]","children":"«Суруди миллӣ»"}],["$","span",null,{"className":"text-[13px] leading-[1.55]","style":{"color":"rgba(255,255,255,.78)"},"children":[["$","span","Музыка — Сулаймон Юдаков.",{"children":[false,"Музыка — Сулаймон Юдаков."]}],["$","span","Слова — Гулназар Келди.",{"children":[["$","br",null,{}],"Слова — Гулназар Келди."]}],["$","span","Утверждён Законом РТ «О Государственном Гимне Республики Таджикистан» в 1994 году.",{"children":[["$","br",null,{}],"Утверждён Законом РТ «О Государственном Гимне Республики Таджикистан» в 1994 году."]}]]}],["$","span",null,{"className":"text-xs","style":{"color":"rgba(255,255,255,.6)"},"children":"Официальная запись гимна публикуется в разделе документов портала."}]]}],["$","div",null,{"className":"min-w-0","children":[["$","span",null,{"className":"text-[11px] uppercase tracking-[.1em]","style":{"color":"var(--color-accent-700)"},"children":"Символ 03"}],["$","h2",null,{"className":"mb-2.5 mt-1.5 text-[26px] uppercase tracking-[.02em]","children":"Государственный Гимн"}],[["$","p","Государственный Гимн исполняется при официальных церемониях: вступлении Президента в должность, открытии сессий Маджлиси Оли, подъёме Государственного Флага, встречах глав иностранных государств, а также в учебных заведениях в начале учебного года.",{"className":"max-w-[64ch] text-[14.5px] leading-[1.65]","children":"Государственный Гимн исполняется при официальных церемониях: вступлении Президента в должность, открытии сессий Маджлиси Оли, подъёме Государственного Флага, встречах глав иностранных государств, а также в учебных заведениях в начале учебного года."}],["$","p","При публичном исполнении Гимна присутствующие слушают его стоя. Не допускается исполнение Гимна в искажённой редакции.",{"className":"max-w-[64ch] text-[14.5px] leading-[1.65]","children":"При публичном исполнении Гимна присутствующие слушают его стоя. Не допускается исполнение Гимна в искажённой редакции."}]],["$","p",null,{"className":"mt-3","style":{"fontSize":12,"color":"color-mix(in srgb,var(--color-text) 65%,transparent)"},"children":["Полный официальный текст на таджикском языке и нотная редакция — в ",["$","$Lf",null,{"href":"/documents","style":{"color":"var(--color-accent-700)"},"children":"каталоге документов"}],"."]}]]}]]}]}]
