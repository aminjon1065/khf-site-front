{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/alerts/layout,_N_T_/[locale]/alerts/page,_N_T_/ru/alerts,cms"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/alerts/__PAGE__",
    "/$d$locale/alerts",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}