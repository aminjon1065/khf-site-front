{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/symbols/layout,_N_T_/[locale]/symbols/page,_N_T_/ru/symbols,cms"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/symbols/__PAGE__",
    "/$d$locale/symbols",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}